{"effective_mode":"compact","effective_text_preview_length":200,"nodes":[{"end_index":0,"paragraph_id":"41D48980","paragraph_index":1,"start_index":0,"type":"Paragraph"},{"end_index":1,"paragraph_index":2,"start_index":1,"type":"Paragraph"},{"end_index":16,"paragraph_id":"641028F9","paragraph_index":3,"start_index":2,"text_preview":"深圳经济特区规划土地监察条例","type":"Paragraph"},{"end_index":17,"paragraph_index":4,"start_index":17,"type":"Paragraph"},{"end_index":504,"paragraph_id":"07D4C064","paragraph_index":5,"start_index":18,"text_preview":"（1995年11月3日深圳市第二届人民代表大会常务委员会第四次会议通过　根据2001年7月27日深圳市第三届人民代表大会常务委员会第八次会议《关于修改〈","type":"Paragraph"},{"end_index":505,"paragraph_index":6,"start_index":505,"type":"Paragraph"},{"end_index":510,"paragraph_id":"57F2AA95","paragraph_index":7,"start_index":506,"text_preview":"目　　录","type":"Paragraph"},{"end_index":519,"paragraph_id":"4D38915F","paragraph_index":8,"start_index":511,"text_preview":"第一章　总　　则","type":"Paragraph"},{"end_index":529,"paragraph_index":9,"start_index":520,"text_preview":"第二章　职责与管辖","type":"Paragraph"},{"end_index":539,"paragraph_index":10,"start_index":530,"text_preview":"第三章　调查与处理","type":"Paragraph"},{"end_index":551,"paragraph_index":11,"start_index":540,"text_preview":"第四章　强制措施与执行","type":"Paragraph"},{"end_index":560,"paragraph_index":12,"start_index":552,"text_preview":"第五章　执法监督","type":"Paragraph"},{"end_index":569,"paragraph_index":13,"start_index":561,"text_preview":"第六章　附　　则","type":"Paragraph"},{"end_index":570,"paragraph_index":14,"start_index":570,"type":"Paragraph"},{"end_index":579,"paragraph_id":"5888BCF4","paragraph_index":15,"start_index":571,"text_preview":"第一章　总　　则","type":"Paragraph"},{"end_index":580,"paragraph_index":16,"start_index":580,"type":"Paragraph"},{"end_index":662,"paragraph_id":"03D3F75D","paragraph_index":17,"start_index":581,"text_preview":"第一条　为了加强规划土地监察工作，规范规划土地监察执法行为，保障城市规划的实施，保护土地资源，根据有关法律、行政法规的基本原则，结合","type":"Paragraph"},{"end_index":687,"paragraph_index":18,"start_index":663,"text_preview":"第二条　深圳经济特区规划土地监察工作适用本条例。","type":"Paragraph"},{"end_index":820,"paragraph_index":19,"start_index":688,"text_preview":"本条例所称规划土地监察，是指对公民、法人和其他组织遵守、执行城市规划和土地管理法律、法规、规章的情况进行监督检查，并依法对违反城市规","type":"Paragraph"},{"end_index":894,"paragraph_index":20,"start_index":821,"text_preview":"第三条　规划土地监察工作应当遵循严格、规范、公正、文明的原则。查处规划违法行为和土地违法行为，应当做到事实清楚、证据确凿、程序合法、","type":"Paragraph"},{"end_index":947,"paragraph_index":21,"start_index":895,"text_preview":"第四条　市人民政府应当建立健全规划土地监察统筹协调工作机制，督促规划土地监察机构和相关部门依法履行职责。","type":"Paragraph"},{"end_index":988,"paragraph_index":22,"start_index":948,"text_preview":"区人民政府（含新区管理机构，下同）负责组织、协调本行政区域内的规划土地监察工作。","type":"Paragraph"},{"end_index":1035,"paragraph_index":23,"start_index":989,"text_preview":"第五条　市规划和自然资源部门是市规划土地监察机构，负责协调、指导、监督全市规划土地监察工作。","type":"Paragraph"},{"end_index":1085,"paragraph_index":24,"start_index":1036,"text_preview":"区人民政府承担规划土地监察职责的部门是区规划土地监察机构，按照职责开展本辖区内的规划土地监察工作。","type":"Paragraph"},{"end_index":1161,"paragraph_index":25,"start_index":1086,"text_preview":"住房建设、交通运输、水务、卫生健康、市场监管、城管和综合执法、消防救援、人口和房屋综合管理等部门和机构，应当在各自职责范围内协助开展","type":"Paragraph"},{"end_index":1245,"paragraph_index":26,"start_index":1162,"text_preview":"第六条　街道办事处按照街道履行职责事项清单要求，负责本辖区内规划违法行为和土地违法行为的投诉举报处理、日常巡查等工作，及时制止相关违","type":"Paragraph"},{"end_index":1316,"paragraph_index":27,"start_index":1246,"text_preview":"街道办事处按照国家和省有关规定承接区规划土地监察机构的行政处罚权、行政检查权和行政强制措施权的，适用本条例关于区规划土地监察机构的有","type":"Paragraph"},{"end_index":1391,"paragraph_index":28,"start_index":1317,"text_preview":"第七条　公安机关应当指定专门机构，协助和配合规划土地监察机构开展规划土地监察工作，对阻碍规划土地监察机构依法执行职务的行为应当及时制","type":"Paragraph"},{"end_index":1429,"paragraph_index":29,"start_index":1392,"text_preview":"探索建立规划土地监察机构和公安机关证据收集、信息共享、执法联动的协作机制。","type":"Paragraph"},{"end_index":1462,"paragraph_index":30,"start_index":1430,"text_preview":"第八条　鼓励公民、法人和其他组织举报规划违法行为和土地违法行为。","type":"Paragraph"},{"end_index":1500,"paragraph_index":31,"start_index":1463,"text_preview":"鼓励新闻媒体加强对规划违法行为、土地违法行为和规划土地监察工作的舆论监督。","type":"Paragraph"},{"end_index":1551,"paragraph_index":32,"start_index":1501,"text_preview":"第九条　鼓励开发建设单位、业主大会、业主委员会预防和控制物业管理区域内的规划违法行为和土地违法行为。","type":"Paragraph"},{"end_index":1612,"paragraph_index":33,"start_index":1552,"text_preview":"对本物业管理区域内的规划违法行为和土地违法行为，业主委员会、物业服务企业应当进行劝阻和制止，并及时向所在街道办事处报告。","type":"Paragraph"},{"end_index":1613,"paragraph_index":34,"start_index":1613,"type":"Paragraph"},{"end_index":1623,"paragraph_index":35,"start_index":1614,"text_preview":"第二章　职责与管辖","type":"Paragraph"},{"end_index":1624,"paragraph_index":36,"start_index":1624,"type":"Paragraph"},{"end_index":1646,"paragraph_index":37,"start_index":1625,"text_preview":"第十条　规划土地监察机构履行下列监察职责：","type":"Paragraph"},{"end_index":1722,"paragraph_index":38,"start_index":1647,"text_preview":"（一）对公民、法人和其他组织遵守、执行规划土地法律、法规、规章的情况进行检查，向有关单位和个人了解情况，查阅、复制或者调取与监察事项","type":"Paragraph"},{"end_index":1782,"paragraph_index":39,"start_index":1723,"text_preview":"（二）对规划违法行为和土地违法行为进行调查，责令停止违法行为，责令有关单位和个人就监察事项所涉及的问题作出解释和说明；","type":"Paragraph"},{"end_index":1797,"paragraph_index":40,"start_index":1783,"text_preview":"（三）依法实施行政强制措施；","type":"Paragraph"},{"end_index":1824,"paragraph_index":41,"start_index":1798,"text_preview":"（四）对规划违法行为和土地违法行为依法实施行政处罚；","type":"Paragraph"},{"end_index":1859,"paragraph_index":42,"start_index":1825,"text_preview":"（五）依法对规划违法行为产生的违法建筑物、构筑物、设施实施强制拆除；","type":"Paragraph"},{"end_index":1882,"paragraph_index":43,"start_index":1860,"text_preview":"（六）依照本条例对违法抢建的建筑物迳行拆除。","type":"Paragraph"},{"end_index":1904,"paragraph_index":44,"start_index":1883,"text_preview":"第十一条　市规划土地监察机构履行下列职责：","type":"Paragraph"},{"end_index":1929,"paragraph_index":45,"start_index":1905,"text_preview":"（一）制定规划土地监察政策并组织实施和监督执行；","type":"Paragraph"},{"end_index":1955,"paragraph_index":46,"start_index":1930,"text_preview":"（二）接受规划违法行为和土地违法行为的投诉、举报；","type":"Paragraph"},{"end_index":2002,"paragraph_index":47,"start_index":1956,"text_preview":"（三）组织查处跨区的或者市人民政府以及上级主管部门指定的规划违法行为和土地违法行为重大案件；","type":"Paragraph"},{"end_index":2020,"paragraph_index":48,"start_index":2003,"text_preview":"（四）组织开展跨区和重大执法行动；","type":"Paragraph"},{"end_index":2050,"paragraph_index":49,"start_index":2021,"text_preview":"（五）监督、指导和检查各区、街道办事处的规划土地监察工作；","type":"Paragraph"},{"end_index":2100,"paragraph_index":50,"start_index":2051,"text_preview":"（六）建立规划土地监察统一信息平台，为全市规划土地监察提供科技手段，实现全市规划土地监察信息共享；","type":"Paragraph"},{"end_index":2123,"paragraph_index":51,"start_index":2101,"text_preview":"（七）市人民政府确定的其他规划土地监察职责。","type":"Paragraph"},{"end_index":2145,"paragraph_index":52,"start_index":2124,"text_preview":"第十二条　区规划土地监察机构履行下列职责：","type":"Paragraph"},{"end_index":2174,"paragraph_index":53,"start_index":2146,"text_preview":"（一）接受辖区内规划违法行为和土地违法行为的投诉、举报；","type":"Paragraph"},{"end_index":2199,"paragraph_index":54,"start_index":2175,"text_preview":"（二）查处辖区内规划违法行为和土地违法行为案件；","type":"Paragraph"},{"end_index":2238,"paragraph_index":55,"start_index":2200,"text_preview":"（三）协调和执行辖区内违法用地清理和违法建筑物、构筑物、设施的强制拆除工作；","type":"Paragraph"},{"end_index":2256,"paragraph_index":56,"start_index":2239,"text_preview":"（四）组织开展本辖区内的执法行动；","type":"Paragraph"},{"end_index":2291,"paragraph_index":57,"start_index":2257,"text_preview":"（五）承办市规划土地监察机构、区人民政府交办的其他规划土地监察事项。","type":"Paragraph"},{"end_index":2343,"paragraph_index":58,"start_index":2292,"text_preview":"区规划土地监察机构可以依法委托具有管理公共事务职能的组织实施涉及规划违法行为和土地违法行为的行政处罚。","type":"Paragraph"},{"end_index":2372,"paragraph_index":59,"start_index":2344,"text_preview":"第十三条　规划违法行为和土地违法行为的查处实行属地管辖。","type":"Paragraph"},{"end_index":2436,"paragraph_index":60,"start_index":2373,"text_preview":"市规划土地监察机构根据需要可以将其管辖的案件交由案件发生地的区规划土地监察机构办理，也可以办理由区规划土地监察机构管辖的案件。","type":"Paragraph"},{"end_index":2539,"paragraph_index":61,"start_index":2437,"text_preview":"区规划土地监察机构、街道办事处对规划违法行为和土地违法行为案件发生管辖争议的，争议各方应当协商解决。协商不成的，属于同一行政区域的，","type":"Paragraph"},{"end_index":2615,"paragraph_index":62,"start_index":2540,"text_preview":"第十四条　建设工程违反城市规划和土地管理法律、法规、规章，同时违反其他法律、法规、规章的，规划土地监察机构和其他有关部门应当在各自职","type":"Paragraph"},{"end_index":2616,"paragraph_index":63,"start_index":2616,"type":"Paragraph"},{"end_index":2626,"paragraph_index":64,"start_index":2617,"text_preview":"第三章　调查与处理","type":"Paragraph"},{"end_index":2627,"paragraph_index":65,"start_index":2627,"type":"Paragraph"},{"end_index":2688,"paragraph_index":66,"start_index":2628,"text_preview":"第十五条　规划土地监察机构应当通过卫星遥感监测、航拍、电子监控和监察人员巡查等方式，及时发现规划违法行为和土地违法行为。","type":"Paragraph"},{"end_index":2782,"paragraph_index":67,"start_index":2689,"text_preview":"规划和自然资源、住房建设、城管和综合执法、人口和房屋综合管理等部门或者机构在办理行政许可、验收、备案或者监管过程中发现规划违法行为和","type":"Paragraph"},{"end_index":2858,"paragraph_index":68,"start_index":2783,"text_preview":"第十六条　规划土地监察机构应当建立定期检查制度，对遵守和执行城市规划和土地管理法律、法规、规章的情况进行全面检查。检查应当作出书面记","type":"Paragraph"},{"end_index":2886,"paragraph_index":69,"start_index":2859,"text_preview":"第十七条　建立健全规划违法行为和土地违法行为举报制度。","type":"Paragraph"},{"end_index":2935,"paragraph_index":70,"start_index":2887,"text_preview":"举报可以采取书面、口头或者其他方式。举报采取口头或者其他方式的，规划土地监察机构应当作详细记录。","type":"Paragraph"},{"end_index":3013,"paragraph_index":71,"start_index":2936,"text_preview":"第十八条　规划土地监察机构对规划违法行为和土地违法行为投诉、举报的受理以及案件的办理，应当通过统一的信息化平台进行，并按照政府信息公","type":"Paragraph"},{"end_index":3055,"paragraph_index":72,"start_index":3014,"text_preview":"第十九条　规划违法行为和土地违法行为符合下列条件的，规划土地监察机构应当予以立案：","type":"Paragraph"},{"end_index":3073,"paragraph_index":73,"start_index":3056,"text_preview":"（一）有证据证明违法行为已经发生；","type":"Paragraph"},{"end_index":3090,"paragraph_index":74,"start_index":3074,"text_preview":"（二）依法应当追究行政法律责任；","type":"Paragraph"},{"end_index":3109,"paragraph_index":75,"start_index":3091,"text_preview":"（三）属于规划土地监察机构管辖范围。","type":"Paragraph"},{"end_index":3167,"paragraph_index":76,"start_index":3110,"text_preview":"符合立案条件的，应当自受理之日起十个工作日内立案。不符合立案条件的，不予立案，并将理由告知案件移送单位或者举报人。","type":"Paragraph"},{"end_index":3252,"paragraph_index":77,"start_index":3168,"text_preview":"第二十条　规划土地监察机构在履行监察职责时，应当有两名以上规划土地监察人员（以下简称监察人员）到场，并出示执法证件。不按照前述规定行","type":"Paragraph"},{"end_index":3303,"paragraph_index":78,"start_index":3253,"text_preview":"第二十一条　监察人员是案件的当事人、当事人的近亲属或者与案件有利害关系的，在案件办理过程中应当回避。","type":"Paragraph"},{"end_index":3376,"paragraph_index":79,"start_index":3304,"text_preview":"监察人员的回避，由本级规划土地监察机构决定。区规划土地监察机构负责人的回避，由区人民政府决定；市规划土地监察机构负责人的回避，由市人","type":"Paragraph"},{"end_index":3494,"paragraph_index":80,"start_index":3377,"text_preview":"规划土地监察机构应当书面告知当事人有申请监察人员回避的权利。当事人申请监察人员回避的，决定机关应当在五个工作日内作出是否回避的决定；","type":"Paragraph"},{"end_index":3568,"paragraph_index":81,"start_index":3495,"text_preview":"第二十二条　立案后，监察人员应当及时对案件进行调查取证。收集、调取的证据范围包括书证、物证、视听资料、证人证言、当事人陈述、鉴定意见","type":"Paragraph"},{"end_index":3632,"paragraph_index":82,"start_index":3569,"text_preview":"第二十三条　监察人员可以收集、调取与案件有关的原始凭证。原始凭证可以复制，但是应当与原件核对无误，并由原件出具人签名或者盖章。","type":"Paragraph"},{"end_index":3693,"paragraph_index":83,"start_index":3633,"text_preview":"第二十四条　在案件办理过程中，规划土地监察机构可以向当事人、证人发出调查询问通知书，通知当事人在规定期限内接受调查询问。","type":"Paragraph"},{"end_index":3774,"paragraph_index":84,"start_index":3694,"text_preview":"监察人员可以询问案件当事人、证人，并制作笔录。笔录经核对无误后由监察人员和被询问人员分别签名或者盖章；被询问人拒绝签名或者盖章的，监","type":"Paragraph"},{"end_index":3819,"paragraph_index":85,"start_index":3775,"text_preview":"第二十五条　对专门性问题需要进行鉴定的，规划土地监察机构应当委托具有鉴定资质的鉴定机构。","type":"Paragraph"},{"end_index":3847,"paragraph_index":86,"start_index":3820,"text_preview":"鉴定机构有权查阅鉴定所需的案件材料、询问当事人和证人。","type":"Paragraph"},{"end_index":3907,"paragraph_index":87,"start_index":3848,"text_preview":"鉴定机构应当就鉴定事项作出鉴定意见，并向规划土地监察机构提交书面鉴定报告。鉴定报告由鉴定人员签名并加盖鉴定机构的印章。","type":"Paragraph"},{"end_index":3924,"paragraph_index":88,"start_index":3908,"text_preview":"鉴定费用由规划土地监察机构承担。","type":"Paragraph"},{"end_index":3958,"paragraph_index":89,"start_index":3925,"text_preview":"第二十六条　监察人员有权进入现场进行勘验或者委托专业机构进行勘验。","type":"Paragraph"},{"end_index":3972,"paragraph_index":90,"start_index":3959,"text_preview":"勘验现场应当制作勘验笔录。","type":"Paragraph"},{"end_index":4033,"paragraph_index":91,"start_index":3973,"text_preview":"第二十七条　监察人员发现规划违法行为或者土地违法行为正在实施或者可能继续实施的，应当及时向当事人发出停止违法行为通知书。","type":"Paragraph"},{"end_index":4052,"paragraph_index":92,"start_index":4034,"text_preview":"停止违法行为通知书应当包括下列内容：","type":"Paragraph"},{"end_index":4067,"paragraph_index":93,"start_index":4053,"text_preview":"（一）当事人的姓名或者名称；","type":"Paragraph"},{"end_index":4086,"paragraph_index":94,"start_index":4068,"text_preview":"（二）违法行为发生的地址等基本情况；","type":"Paragraph"},{"end_index":4107,"paragraph_index":95,"start_index":4087,"text_preview":"（三）违反法律、法规、规章的事实和证据；","type":"Paragraph"},{"end_index":4124,"paragraph_index":96,"start_index":4108,"text_preview":"（四）停止违法行为的要求和依据；","type":"Paragraph"},{"end_index":4141,"paragraph_index":97,"start_index":4125,"text_preview":"（五）不停止违法行为的法律后果；","type":"Paragraph"},{"end_index":4173,"paragraph_index":98,"start_index":4142,"text_preview":"（六）作出停止违法行为通知书的规划土地监察机构印章和作出日期。","type":"Paragraph"},{"end_index":4213,"paragraph_index":99,"start_index":4174,"text_preview":"当事人姓名或者名称暂时难以确定的，可以表述为违法建设行为人或者违法用地行为人。","type":"Paragraph"},{"end_index":4265,"paragraph_index":100,"start_index":4214,"text_preview":"第二十八条　停止违法行为通知书已经送达而违法行为人继续抢建的，规划土地监察机构可以对抢建部分迳行拆除。","type":"Paragraph"},{"end_index":4301,"paragraph_index":101,"start_index":4266,"text_preview":"第二十九条　案件调查结束后，规划土地监察机构应当按照下列方式分别处理：","type":"Paragraph"},{"end_index":4329,"paragraph_index":102,"start_index":4302,"text_preview":"（一）无违法事实或者主要证据不足的，不得给予行政处罚；","type":"Paragraph"},{"end_index":4357,"paragraph_index":103,"start_index":4330,"text_preview":"（二）违法事实清楚、证据确实充分的，依法作出行政处罚；","type":"Paragraph"},{"end_index":4395,"paragraph_index":104,"start_index":4358,"text_preview":"（三）违法行为轻微，不予行政处罚的，可以通过录像等方式予以记录并跟踪监管。","type":"Paragraph"},{"end_index":4464,"paragraph_index":105,"start_index":4396,"text_preview":"规划土地监察机构作出行政处罚决定之前，应当依法告知当事人享有陈述、申辩以及要求举行听证的权利。当事人申请听证的，按照听证的有关规定办","type":"Paragraph"},{"end_index":4500,"paragraph_index":106,"start_index":4465,"text_preview":"第三十条　规划土地监察机构对规划违法行为和土地违法行为的处罚种类包括：","type":"Paragraph"},{"end_index":4507,"paragraph_index":107,"start_index":4501,"text_preview":"（一）罚款；","type":"Paragraph"},{"end_index":4528,"paragraph_index":108,"start_index":4508,"text_preview":"（二）限期拆除违法建筑物、构筑物、设施；","type":"Paragraph"},{"end_index":4547,"paragraph_index":109,"start_index":4529,"text_preview":"（三）没收违法建筑物、构筑物、设施；","type":"Paragraph"},{"end_index":4558,"paragraph_index":110,"start_index":4548,"text_preview":"（四）没收违法所得；","type":"Paragraph"},{"end_index":4577,"paragraph_index":111,"start_index":4559,"text_preview":"（五）法律、行政法规规定的其他处罚。","type":"Paragraph"},{"end_index":4598,"paragraph_index":112,"start_index":4578,"text_preview":"第三十一条　行政处罚决定书包括下列内容：","type":"Paragraph"},{"end_index":4611,"paragraph_index":113,"start_index":4599,"text_preview":"（一）当事人的基本情况；","type":"Paragraph"},{"end_index":4620,"paragraph_index":114,"start_index":4612,"text_preview":"（二）违法事实；","type":"Paragraph"},{"end_index":4629,"paragraph_index":115,"start_index":4621,"text_preview":"（三）处罚依据；","type":"Paragraph"},{"end_index":4638,"paragraph_index":116,"start_index":4630,"text_preview":"（四）处罚内容；","type":"Paragraph"},{"end_index":4658,"paragraph_index":117,"start_index":4639,"text_preview":"（五）申请行政复议的期限以及复议机关；","type":"Paragraph"},{"end_index":4686,"paragraph_index":118,"start_index":4659,"text_preview":"（六）向人民法院提起诉讼的期限以及有管辖权的人民法院；","type":"Paragraph"},{"end_index":4709,"paragraph_index":119,"start_index":4687,"text_preview":"（七）规划土地监察机构印章和作出决定的日期。","type":"Paragraph"},{"end_index":4805,"paragraph_index":120,"start_index":4710,"text_preview":"第三十二条　规划土地监察机构对违法建筑物、构筑物、设施作出限期拆除的行政处罚决定后，应当依法送达并在三个工作日内将决定书内容予以公告","type":"Paragraph"},{"end_index":4907,"paragraph_index":121,"start_index":4806,"text_preview":"第三十三条　规划土地监察机构送达有关法律文书，应当直接送达。受送达人是法人或者其他组织的，交其法定代表人、负责人或者收发部门签收；受","type":"Paragraph"},{"end_index":5046,"paragraph_index":122,"start_index":4908,"text_preview":"受送达人拒绝签收的，送达人可以邀请有关基层组织或者受送达人所在单位的代表到场，说明情况，在送达回证上记明拒收事由和日期，由送达人、见","type":"Paragraph"},{"end_index":5140,"paragraph_index":123,"start_index":5047,"text_preview":"对已经书面确认送达地址或者依法可以确定住所的受送达人，可以邮寄送达。受送达人、受送达人成年家属或者受送达人收发部门签收的，即视为送达","type":"Paragraph"},{"end_index":5186,"paragraph_index":124,"start_index":5141,"text_preview":"受送达人同意并签订确认书的，规划土地监察机构可以采用传真、电子邮件等方式送达有关法律文书。","type":"Paragraph"},{"end_index":5295,"paragraph_index":125,"start_index":5187,"text_preview":"对于有关违法建筑物、构筑物、设施的法律文书，采用本条第一款规定的方式无法送达的，规划土地监察机构将相关法律文书张贴在该违法建筑物、构","type":"Paragraph"},{"end_index":5357,"paragraph_index":126,"start_index":5296,"text_preview":"采取上述方式无法送达的，经本级规划土地监察机构负责人批准，可以在本市主要报刊公告送达。自公告发布之日起三十日，即视为送达。","type":"Paragraph"},{"end_index":5441,"paragraph_index":127,"start_index":5358,"text_preview":"第三十四条　违法案件的调查处理，应当自立案之日起三个月内完成。因特殊情况不能完成的，经本级规划土地监察机构负责人批准，可以适当延长，","type":"Paragraph"},{"end_index":5476,"paragraph_index":128,"start_index":5442,"text_preview":"规划土地监察机构应当在批准延期后将延期事项告知当事人或者利害关系人。","type":"Paragraph"},{"end_index":5555,"paragraph_index":129,"start_index":5477,"text_preview":"第三十五条　对未经批准或者未按照批准内容进行建设的临时建筑物、构筑物、设施以及超过批准期限未拆除的临时建筑物、构筑物、设施，由规划土","type":"Paragraph"},{"end_index":5592,"paragraph_index":130,"start_index":5556,"text_preview":"规划土地监察机构拆除违法临时建筑物、构筑物、设施，可以按照以下程序进行：","type":"Paragraph"},{"end_index":5639,"paragraph_index":131,"start_index":5593,"text_preview":"（一）书面通知当事人限期自行拆除，并将限期拆除通知张贴在临时建筑物、构筑物、设施的显著位置；","type":"Paragraph"},{"end_index":5685,"paragraph_index":132,"start_index":5640,"text_preview":"（二）当事人逾期不拆除的，由违法临时建筑物、构筑物、设施所在区的规划土地监察机构予以拆除。","type":"Paragraph"},{"end_index":5755,"paragraph_index":133,"start_index":5686,"text_preview":"第三十六条　因行政处罚需要对建筑物、构筑物、设施进行价值评估的，由规划土地监察机构依法确定的评估机构实施。评估费用由规划土地监察机构","type":"Paragraph"},{"end_index":5810,"paragraph_index":134,"start_index":5756,"text_preview":"第三十七条　违法加建、改建的当事人以拒绝入户等方式阻碍监察人员进行现场检查、勘验等执法活动的，处五万元罚款。","type":"Paragraph"},{"end_index":5946,"paragraph_index":135,"start_index":5811,"text_preview":"第三十八条　规划土地监察机构在履行监察职责时，发现向违反城市规划或者土地管理法律、法规、规章的建设工程供水、供电或者出售预拌混凝土的","type":"Paragraph"},{"end_index":6042,"paragraph_index":136,"start_index":5947,"text_preview":"第三十九条　对涉及规划违法行为或者土地违法行为的房地产，规划土地监察机构可以作出决定，限制其首次登记或者转移、抵押登记。不动产登记机","type":"Paragraph"},{"end_index":6107,"paragraph_index":137,"start_index":6043,"text_preview":"违法状态消除或者当事人履行有关行政处罚决定后，规划土地监察机构应当作出决定，并及时通知不动产登记机构解除对有关房地产的权利限制。","type":"Paragraph"},{"end_index":6108,"paragraph_index":138,"start_index":6108,"type":"Paragraph"},{"end_index":6120,"paragraph_index":139,"start_index":6109,"text_preview":"第四章　强制措施与执行","type":"Paragraph"},{"end_index":6121,"paragraph_index":140,"start_index":6121,"type":"Paragraph"},{"end_index":6187,"paragraph_index":141,"start_index":6122,"text_preview":"第四十条　规划土地监察机构在查处违法行为过程中，对与违法行为有直接关系的场所、设施或者财物，可以依法实施查封、扣押等行政强制措施。","type":"Paragraph"},{"end_index":6269,"paragraph_index":142,"start_index":6188,"text_preview":"第四十一条　规划土地监察机构实施查封、扣押行政强制措施的，应当向当事人发出经本级规划土地监察机构负责人签发的查封、扣押决定书，并可以","type":"Paragraph"},{"end_index":6339,"paragraph_index":143,"start_index":6270,"text_preview":"规划土地监察机构实施查封、扣押时，应当制作查封、扣押清单一式两份，由监察人员、当事人或者见证人签名后，由当事人和规划土地监察机构分别","type":"Paragraph"},{"end_index":6408,"paragraph_index":144,"start_index":6340,"text_preview":"第四十二条　被查封的财物，由规划土地监察机构加封封条，并妥善保管。规划土地监察机构也可以委托第三人保管，保管费用由规划土地监察机构承","type":"Paragraph"},{"end_index":6431,"paragraph_index":145,"start_index":6409,"text_preview":"被扣押的财物，规划土地监察机构应当妥善保管。","type":"Paragraph"},{"end_index":6509,"paragraph_index":146,"start_index":6432,"text_preview":"第四十三条　查封、扣押的期限不得超过三十日；情况复杂的，经规划土地监察机构负责人批准，可以延长，但是延长期限不得超过三十日。法律、行","type":"Paragraph"},{"end_index":6602,"paragraph_index":147,"start_index":6510,"text_preview":"第四十四条　当事人对行政处罚决定逾期不履行的，规划土地监察机构应当依法催告当事人履行义务。经催告，当事人仍不履行，且未在法定期限内申","type":"Paragraph"},{"end_index":6725,"paragraph_index":148,"start_index":6603,"text_preview":"（一）依照城市规划法律、法规、规章作出的限期拆除行政处罚，由违法建筑物、构筑物、设施所在区的规划土地监察机构作出行政强制执行决定予以","type":"Paragraph"},{"end_index":6763,"paragraph_index":149,"start_index":6726,"text_preview":"（二）其他行政处罚，由作出处罚决定的规划土地监察机构申请人民法院强制执行。","type":"Paragraph"},{"end_index":6890,"paragraph_index":150,"start_index":6764,"text_preview":"规划土地监察机构应当在申请行政复议的法定期限或者提起行政诉讼的法定期限届满之日起三个月内申请人民法院强制执行；当事人对行政处罚决定提","type":"Paragraph"},{"end_index":6987,"paragraph_index":151,"start_index":6891,"text_preview":"第四十五条　对于市规划土地监察机构依照城市规划法律、法规、规章作出的限期拆除的行政处罚决定，符合强制执行条件的，由违法建筑物、构筑物","type":"Paragraph"},{"end_index":7063,"paragraph_index":152,"start_index":6988,"text_preview":"前款所称符合强制执行条件，是指经依法公告、催告，当事人未在法定期限内申请行政复议或者提起行政诉讼，或者行政复议决定、行政诉讼判决维持","type":"Paragraph"},{"end_index":7118,"paragraph_index":153,"start_index":7064,"text_preview":"第四十六条　规划土地监察机构在实施强制拆除前，应当对拟拆除的违法建筑物、构筑物、设施进行勘验并制作勘验笔录。","type":"Paragraph"},{"end_index":7162,"paragraph_index":154,"start_index":7119,"text_preview":"勘验笔录应当包括违法建筑物、构筑物、设施的名称、地点、结构、建筑面积、装修标准等内容。","type":"Paragraph"},{"end_index":7214,"paragraph_index":155,"start_index":7163,"text_preview":"第四十七条　规划土地监察机构实施强制拆除时，应当通知当事人到场。当事人不到场的，不影响强制拆除的执行。","type":"Paragraph"},{"end_index":7230,"paragraph_index":156,"start_index":7215,"text_preview":"强制拆除的费用，由当事人承担。","type":"Paragraph"},{"end_index":7366,"paragraph_index":157,"start_index":7231,"text_preview":"第四十八条　规划土地监察机构实施强制拆除时，应当根据实际需要，通知交通运输、卫生健康、市场监管、城管和综合执法、消防救援等部门和机构","type":"Paragraph"},{"end_index":7412,"paragraph_index":158,"start_index":7367,"text_preview":"规划土地监察机构实施强制拆除时，区人民政府、街道办事处应当根据需要对拆除行动进行组织协调。","type":"Paragraph"},{"end_index":7536,"paragraph_index":159,"start_index":7413,"text_preview":"第四十九条　违法建筑物、构筑物、设施被拆除时，对于敷设其上的设备，应当一并拆除。室内未搬迁的物品，由规划土地监察机构代为搬迁，并交予","type":"Paragraph"},{"end_index":7564,"paragraph_index":160,"start_index":7537,"text_preview":"三个月后仍无人认领的，按照确认无主财产的法律程序处理。","type":"Paragraph"},{"end_index":7596,"paragraph_index":161,"start_index":7565,"text_preview":"第五十条　有下列情形之一的，规划土地监察机构应当中止强制拆除：","type":"Paragraph"},{"end_index":7624,"paragraph_index":162,"start_index":7597,"text_preview":"（一）人民法院裁定或者复议机关决定中止执行强制拆除的；","type":"Paragraph"},{"end_index":7652,"paragraph_index":163,"start_index":7625,"text_preview":"（二）第三人对执行标的提出异议，经审查认为确有理由的；","type":"Paragraph"},{"end_index":7680,"paragraph_index":164,"start_index":7653,"text_preview":"（三）规划土地监察机构认为需要中止强制拆除的其他情形。","type":"Paragraph"},{"end_index":7707,"paragraph_index":165,"start_index":7681,"text_preview":"中止强制拆除的情形消失后，应当立即恢复实施强制拆除。","type":"Paragraph"},{"end_index":7740,"paragraph_index":166,"start_index":7708,"text_preview":"第五十一条　有下列情形之一的，规划土地监察机构应当终结强制拆除：","type":"Paragraph"},{"end_index":7768,"paragraph_index":167,"start_index":7741,"text_preview":"（一）人民法院判决或者复议机关决定撤销强制拆除决定的；","type":"Paragraph"},{"end_index":7793,"paragraph_index":168,"start_index":7769,"text_preview":"（二）当事人自行拆除违法建筑物、构筑物、设施的；","type":"Paragraph"},{"end_index":7821,"paragraph_index":169,"start_index":7794,"text_preview":"（三）规划土地监察机构认为需要终结强制拆除的其他情形。","type":"Paragraph"},{"end_index":7858,"paragraph_index":170,"start_index":7822,"text_preview":"第五十二条　强制拆除执行人员应当制作执行笔录。执行笔录应当包括下列内容：","type":"Paragraph"},{"end_index":7892,"paragraph_index":171,"start_index":7859,"text_preview":"（一）当事人姓名、住所或者名称、法定代表人或者负责人姓名、职务等；","type":"Paragraph"},{"end_index":7911,"paragraph_index":172,"start_index":7893,"text_preview":"（二）被执行强制拆除物的名称、地点；","type":"Paragraph"},{"end_index":7929,"paragraph_index":173,"start_index":7912,"text_preview":"（三）强制拆除的时间、过程及结果；","type":"Paragraph"},{"end_index":7949,"paragraph_index":174,"start_index":7930,"text_preview":"（四）执行强制拆除人员、见证人员签名；","type":"Paragraph"},{"end_index":7962,"paragraph_index":175,"start_index":7950,"text_preview":"（五）制作执行笔录时间。","type":"Paragraph"},{"end_index":8022,"paragraph_index":176,"start_index":7963,"text_preview":"第五十三条　违法建筑物、构筑物、设施被依法没收的，由市、区人民政府指定的部门或者机构与当事人或者人民法院办理交接手续。","type":"Paragraph"},{"end_index":8120,"paragraph_index":177,"start_index":8023,"text_preview":"被依法没收的违法建筑物、构筑物、设施需要办理产权登记的，由接收单位依法补办相关手续后凭行政处罚决定书或者人民法院强制执行法律文书以及","type":"Paragraph"},{"end_index":8187,"paragraph_index":178,"start_index":8121,"text_preview":"第五十四条　当事人因规划违法行为或者土地违法行为受到行政处罚的，规划土地监察机构应当按照相关规定将违法行为信息纳入公共信用信息系统。","type":"Paragraph"},{"end_index":8246,"paragraph_index":179,"start_index":8188,"text_preview":"第五十五条　当事人对规划土地监察机构作出的行政处罚、行政强制等行政行为不服的，可以依法申请行政复议或者提起行政诉讼。","type":"Paragraph"},{"end_index":8247,"paragraph_index":180,"start_index":8247,"type":"Paragraph"},{"end_index":8256,"paragraph_index":181,"start_index":8248,"text_preview":"第五章　执法监督","type":"Paragraph"},{"end_index":8257,"paragraph_index":182,"start_index":8257,"type":"Paragraph"},{"end_index":8304,"paragraph_index":183,"start_index":8258,"text_preview":"第五十六条　市、区人民政府应当建立健全查处规划违法行为和土地违法行为工作责任制、行政问责制。","type":"Paragraph"},{"end_index":8445,"paragraph_index":184,"start_index":8305,"text_preview":"第五十七条　市人民政府应当建立规划土地工作督察制度，对市有关部门和区人民政府执行城市规划和土地管理法律、法规、规章的情况以及规划土地","type":"Paragraph"},{"end_index":8526,"paragraph_index":185,"start_index":8446,"text_preview":"第五十八条　任何组织或者个人有权检举、控告规划土地监察机构在履行规划土地监察职责中的违法行为，有关机关应当依法予以查处，并将处理结果","type":"Paragraph"},{"end_index":8566,"paragraph_index":186,"start_index":8527,"text_preview":"第五十九条　上级规划土地监察机构应当对下级规划土地监察工作的下列事项进行监督：","type":"Paragraph"},{"end_index":8591,"paragraph_index":187,"start_index":8567,"text_preview":"（一）重大执法行动的部署、措施的组织和执行情况；","type":"Paragraph"},{"end_index":8613,"paragraph_index":188,"start_index":8592,"text_preview":"（二）巡查制度的落实及案件的调查处理情况；","type":"Paragraph"},{"end_index":8640,"paragraph_index":189,"start_index":8614,"text_preview":"（三）执法证件、标识、设备及其他执法装备的使用情况；","type":"Paragraph"},{"end_index":8679,"paragraph_index":190,"start_index":8641,"text_preview":"（四）规划土地监察机构队伍纪律、廉政建设及其监察人员遵守纪律、廉洁自律情况；","type":"Paragraph"},{"end_index":8709,"paragraph_index":191,"start_index":8680,"text_preview":"（五）群众通过信访、投诉反映的涉及监察人员违法违纪的情况；","type":"Paragraph"},{"end_index":8747,"paragraph_index":192,"start_index":8710,"text_preview":"（六）其他规划土地监察机构及其监察人员行使职权、履行职责和遵守纪律的情况。","type":"Paragraph"},{"end_index":8790,"paragraph_index":193,"start_index":8748,"text_preview":"在监督检查中发现问题的，上级规划土地监察机构应当采取通知、建议等方式进行纠正和督办。","type":"Paragraph"},{"end_index":8834,"paragraph_index":194,"start_index":8791,"text_preview":"第六十条　监察人员有下列情形之一的，其所在单位、有关机关应当责令改正，并依法给予处分：","type":"Paragraph"},{"end_index":8872,"paragraph_index":195,"start_index":8835,"text_preview":"（一）接到规划违法行为或者土地违法行为投诉、举报后不按照规定受理、登记的；","type":"Paragraph"},{"end_index":8919,"paragraph_index":196,"start_index":8873,"text_preview":"（二）在责任地段内不履行日常巡查职责，未能及时发现规划违法行为或者土地违法行为，情节严重的；","type":"Paragraph"},{"end_index":8953,"paragraph_index":197,"start_index":8920,"text_preview":"（三）发现规划违法行为或者土地违法行为不制止、不报告，情节严重的；","type":"Paragraph"},{"end_index":8984,"paragraph_index":198,"start_index":8954,"text_preview":"（四）对规划违法行为或者土地违法行为不依法处理，情节严重的；","type":"Paragraph"},{"end_index":8999,"paragraph_index":199,"start_index":8985,"text_preview":"（五）其他不依法履行职责的。","type":"Paragraph"},{"end_index":9102,"paragraph_index":200,"start_index":9000,"text_preview":"第六十一条　负有协助查处规划违法行为或者土地违法行为职责的有关单位或者个人，不配合规划土地监察机构的执法工作，其所在部门或者单位、有","type":"Paragraph"},{"end_index":9140,"paragraph_index":201,"start_index":9103,"text_preview":"第六十二条　审计部门应当加强对违法建筑物、构筑物、设施没收工作的监督检查。","type":"Paragraph"},{"end_index":9241,"paragraph_index":202,"start_index":9141,"text_preview":"对依法没收的违法建筑物、构筑物、设施，市、区人民政府指定的部门或者机构怠于与当事人或者人民法院办理交接手续，致使执行工作受阻或者国有","type":"Paragraph"},{"end_index":9323,"paragraph_index":203,"start_index":9242,"text_preview":"第六十三条　规划和自然资源等相关部门及其工作人员在行政管理活动中，违反规定作出规划土地审批、许可或者其他行政行为，依法追究行政责任；","type":"Paragraph"},{"end_index":9409,"paragraph_index":204,"start_index":9324,"text_preview":"规划土地监察机构在查处规划违法行为和土地违法行为过程中发现前款规定的规划土地审批、许可或者其他行政行为涉嫌违法的，应当及时提请有关机","type":"Paragraph"},{"end_index":9410,"paragraph_index":205,"start_index":9410,"type":"Paragraph"},{"end_index":9419,"paragraph_index":206,"start_index":9411,"text_preview":"第六章　附　　则","type":"Paragraph"},{"end_index":9420,"paragraph_index":207,"start_index":9420,"type":"Paragraph"},{"end_index":9455,"paragraph_index":208,"start_index":9421,"text_preview":"第六十四条　对农村城市化历史遗留违法建筑的处理另有规定的，从其规定。","type":"Paragraph"},{"end_index":9481,"paragraph_index":209,"start_index":9456,"text_preview":"第六十五条　市人民政府可以依据本条例制定实施细则。","type":"Paragraph"},{"end_index":9505,"paragraph_index":210,"start_index":9482,"text_preview":"第六十六条　本条例自2014年3月1日起施行。","type":"Paragraph"}],"pagination":{"has_more":false,"limit":0,"offset":0,"returned_nodes":210,"total_nodes":210},"stats":{"total_headings":0,"total_numbering_lists":0,"total_paragraphs":210,"total_tables":0},"version":0}
