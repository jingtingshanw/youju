# 复制到项目上一级目录，命名 .env，chmod 600
# 项目在 /srv/policy-verify-engine 时，这个文件要在 /srv/.env

# ── 模型通道：三家任选，至少配一家 ──────────────────
# 顺序即优先级，core.pick_providers 按 ARK → DASHSCOPE → DEEPSEEK 排，
# 调用失败自动换下一家。

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── 服务 ──────────────────────────────────────
# PV_TOKEN 不设等于不鉴权。公网上必须设，本地调试可以不设。
PV_TOKEN=
PV_PORT=8848
PV_BIND=127.0.0.1

# ── 降级开关（平时留空）─────────────────────────
# QW_RAW_ONLY=1  撰写不调模型，只排原文条文
# QW_DISABLE_WEB=1  关联网，只查本地库
